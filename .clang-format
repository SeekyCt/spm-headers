BasedOnStyle: LLVM

AllowShortFunctionsOnASingleLine: None
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: false
  BeforeCatch: true
  BeforeElse: true
  BeforeWhile: true
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

ColumnLimit: 100

IndentWidth: 4
IndentCaseLabels: true
IndentPPDirectives: BeforeHash

PointerAlignment: Middle
SortIncludes: CaseInsensitive

OneLineFormatOffRegex: \
  (^\/\* 0x[a-fA-F0-9]+ \*\/\
  |^// evt_)

IncludeCategories:
  - Regex: "^<spm/"
    Priority: 2
  - Regex: "^<wii/"
    Priority: 3
  - Regex: "^<nw4r/"
    Priority: 4
  - Regex: ^<msl/'
    Priority: 5
  - Regex: ".*"
    Priority: 1
