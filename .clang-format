Language: Cpp
BasedOnStyle: LLVM

AlignEscapedNewlines: DontAlign
AlignTrailingComments: Leave
AllowShortFunctionsOnASingleLine: None
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterExternBlock: false
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeWhile: true
  SplitEmptyFunction: false
  SplitEmptyNamespace: true
  SplitEmptyRecord: true
ColumnLimit: 100
IndentWidth: 4
IndentCaseLabels: true
IndentPPDirectives: Leave
PointerAlignment: Middle
ReflowComments: Never
SkipMacroDefinitionBody: true
SortIncludes: CaseInsensitive
SpaceAfterCStyleCast: true
SpaceBeforeCpp11BracedList: true

# Ignore:
# - Offset comments
# - Stubbed offset comments (version differences)
OneLineFormatOffRegex: >-
  ^\/\* 0x[a-fA-F0-9]+ \*\/|
  |^\/\* +\*\/

IncludeCategories:
  - Regex: ^<common.h>
    Priority: 0
  - Regex: ^<[^/]+>
    Priority: 1
  - Regex: ^<spm/
    Priority: 2
  - Regex: ^<wii/
    Priority: 3
  - Regex: ^<nw4r/
    Priority: 4
  - Regex: ^<msl/
    Priority: 5
  - Regex: .*
    Priority: 6

WhitespaceSensitiveMacros:
  - SPM_ASSERT
  - SPM_ASSERT_
  - SPM_ASSERT_NM
  - SPM_ASSERT_NM_
